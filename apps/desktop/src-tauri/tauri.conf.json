{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaNinja",
  "version": "0.1.1",
  "identifier": "io.medianinja.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. build:sidecar",
    "beforeBuildCommand": "pnpm --dir ../.. build:sidecar",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "desktop"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/medianinja-core",
      "binaries/ffmpeg"
    ],
    "resources": {
      "resources/ffmpeg/": "licenses/ffmpeg/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
