{
  "name": "medianinja-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @medianinja/frontend dev",
    "build:frontend": "pnpm --filter @medianinja/frontend build",
    "build:web": "node scripts/build.mjs web",
    "build:sidecar": "node scripts/build.mjs sidecar",
    "prepare:ffmpeg": "node scripts/ffmpeg.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "release:build": "node scripts/release.mjs",
    "test:release": "node --test scripts/version.test.mjs scripts/ffmpeg.test.mjs",
    "test:ffmpeg": "node scripts/test-ffmpeg.mjs",
    "desktop:dev": "pnpm --filter @medianinja/desktop dev",
    "desktop:build": "pnpm --filter @medianinja/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:sidecar": "node scripts/test-sidecar.mjs"
  }
}
