{
  "version": "8.1.3",
  "source": {
    "url": "https://ffmpeg.org/releases/ffmpeg-8.1.3.tar.xz",
    "sha256": "7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3"
  },
  "toolchain": {
    "version": "2.10.0",
    "url": "https://github.com/skeeto/w64devkit/releases/download/v2.10.0/w64devkit-x64-2.10.0.7z.exe",
    "sha256": "18d0a4c71a166f8401ab6305781bec5882b40b5e06ba9807c61cb5f3b3c6325e"
  },
  "configure": [
    "--target-os=mingw32",
    "--arch=x86_64",
    "--enable-cross-compile",
    "--cc=gcc",
    "--disable-autodetect",
    "--disable-everything",
    "--disable-gpl",
    "--disable-nonfree",
    "--disable-shared",
    "--enable-static",
    "--disable-x86asm",
    "--disable-debug",
    "--disable-doc",
    "--disable-network",
    "--disable-avdevice",
    "--enable-ffmpeg",
    "--enable-protocol=file",
    "--enable-demuxer=mpegts,mov,wav",
    "--enable-muxer=mp4,mpegts",
    "--enable-decoder=aac,ac3,eac3,h264,hevc,mp3,mpeg2video,pcm_s16le",
    "--enable-parser=aac,ac3,h264,hevc,mpegaudio,mpegvideo",
    "--enable-bsf=aac_adtstoasc,extract_extradata,h264_mp4toannexb,hevc_mp4toannexb",
    "--enable-encoder=aac",
    "--enable-filter=aresample,anull,aformat,format,null"
  ]
}
